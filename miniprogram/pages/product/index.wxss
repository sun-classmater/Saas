.product-detail-page { padding-bottom: 180rpx; }
.product-hero { height: 370rpx; background: linear-gradient(150deg, #e1ebe8, #faf8ef); position: relative; overflow: hidden; padding: 30rpx; display: flex; align-items: flex-end; }
.product-category { font-size: 62rpx; font-weight: 800; color: rgba(16,43,67,.75); letter-spacing: 8rpx; }
.visual-ring { position: absolute; width: 290rpx; height: 290rpx; right: -40rpx; top: 20rpx; border-radius: 50%; border: 35rpx solid rgba(8,127,120,.1); box-shadow: 0 0 0 45rpx rgba(242,139,60,.06); }
.product-number { position: absolute; top: 28rpx; left: 30rpx; font-size: 21rpx; color: var(--muted); letter-spacing: 2rpx; }
.detail-head { display: flex; justify-content: space-between; gap: 20rpx; padding: 30rpx 8rpx 12rpx; }
.product-title { display: block; font-size: 39rpx; font-weight: 700; line-height: 1.35; }
.product-sub { display: block; color: var(--muted); font-size: 22rpx; margin-top: 10rpx; }
.price-main { color: var(--teal); font-size: 37rpx; font-weight: 800; white-space: nowrap; }
.price-note { padding: 18rpx 22rpx; color: #57706d; font-size: 22rpx; background: #edf7f4; }
.section-card { padding: 26rpx; margin-top: 20rpx; }
.section-label { display: block; font-size: 28rpx; font-weight: 700; margin-bottom: 10rpx; }
.description { display: block; color: var(--muted); font-size: 24rpx; line-height: 1.75; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); }
.purchase-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 9; display: flex; gap: 18rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,253,249,.96); border-top: 1rpx solid var(--line); }
.quantity-control { display: flex; align-items: center; border: 1rpx solid var(--line); border-radius: 15rpx; overflow: hidden; background: #fff; }
.quantity-control button { width: 62rpx; height: 76rpx; line-height: 76rpx; padding: 0; background: transparent; font-size: 32rpx; }
.quantity-control text { width: 72rpx; text-align: center; font-weight: 700; }
.add-cart { flex: 1; height: 78rpx; }
