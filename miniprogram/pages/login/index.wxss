.login-page { min-height: 100vh; background: var(--paper); }
.hero { min-height: 600rpx; padding: 70rpx 52rpx 60rpx; position: relative; overflow: hidden; color: #fff; background: radial-gradient(circle at 100% 20%, rgba(25,167,157,.36), transparent 40%), linear-gradient(150deg, var(--navy-deep), var(--navy) 70%, #165164); }
.hero::after { content: ""; position: absolute; width: 560rpx; height: 560rpx; right: -290rpx; top: 120rpx; border: 1rpx solid rgba(255,255,255,.12); border-radius: 50%; box-shadow: 0 0 0 70rpx rgba(255,255,255,.025), 0 0 0 140rpx rgba(255,255,255,.018); }
.brand-mark { width: 82rpx; height: 82rpx; background: var(--orange); color: #fff; border-radius: 22rpx 22rpx 22rpx 5rpx; display: flex; align-items: center; justify-content: center; font-size: 42rpx; font-weight: 800; margin-bottom: 70rpx; }
.hero .eyebrow { color: #77d5ce; font-size: 21rpx; letter-spacing: 4rpx; }
.hero-title { display: block; font-size: 64rpx; line-height: 1.25; font-weight: 700; letter-spacing: -2rpx; margin-top: 18rpx; position: relative; z-index: 1; }
.hero-copy { display: block; color: rgba(255,255,255,.65); margin-top: 26rpx; line-height: 1.7; font-size: 25rpx; position: relative; z-index: 1; }
.road-shape { position: absolute; width: 120rpx; height: 350rpx; right: 78rpx; bottom: -70rpx; border-left: 3rpx solid rgba(242,139,60,.75); border-right: 3rpx solid rgba(242,139,60,.75); transform: skewX(-16deg); opacity: .8; }
.login-panel { position: relative; margin-top: -42rpx; border-radius: 40rpx 40rpx 0 0; background: var(--paper); padding: 48rpx 48rpx 80rpx; min-height: 480rpx; }
.login-title { display: block; font-size: 38rpx; font-weight: 700; margin-bottom: 10rpx; }
.login-copy { display: block; color: var(--muted); font-size: 24rpx; margin-bottom: 40rpx; }
.phone-input { height: 92rpx; font-size: 32rpx; letter-spacing: 2rpx; }
.login-button { width: 100%; margin-top: 30rpx; height: 92rpx; }
.login-note { display: flex; justify-content: space-between; color: var(--muted); font-size: 20rpx; margin-top: 25rpx; }
.demo-phones { margin-top: 45rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); color: #96a1a7; font-size: 20rpx; text-align: center; }
