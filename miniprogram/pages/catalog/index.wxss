.catalog-page { min-height: 100vh; }
.catalog-head { padding: 40rpx 34rpx 30rpx; background: linear-gradient(150deg, var(--navy-deep), var(--navy) 75%, #165164); color: #fff; border-radius: 0 0 40rpx 40rpx; }
.head-top { display: flex; justify-content: space-between; gap: 20rpx; align-items: flex-start; position: relative; z-index: 1; }
.catalog-head .eyebrow { color: #77d5ce; }
.welcome { display: block; font-size: 38rpx; font-weight: 700; max-width: 480rpx; line-height: 1.4; }
.channel-badge { padding: 10rpx 15rpx; border: 1rpx solid rgba(255,255,255,.2); border-radius: 30rpx; color: #bde9e5; font-size: 20rpx; white-space: nowrap; }
.head-copy { color: rgba(255,255,255,.6); font-size: 23rpx; margin: 18rpx 0 28rpx; }
.search-wrap { height: 82rpx; border-radius: 18rpx; background: rgba(255,255,255,.1); display: flex; align-items: center; padding: 0 22rpx; border: 1rpx solid rgba(255,255,255,.13); }
.search-wrap input { flex: 1; color: #fff; font-size: 25rpx; height: 100%; }
.search-icon { color: rgba(255,255,255,.55); margin-right: 12rpx; font-size: 35rpx; }
.category-scroll { white-space: nowrap; padding: 25rpx 0 4rpx; }
.category-row { display: inline-flex; gap: 14rpx; padding: 0 28rpx; }
.category-chip { padding: 17rpx 28rpx; border-radius: 34rpx; background: var(--paper); color: var(--muted); border: 1rpx solid var(--line); font-size: 23rpx; }
.category-chip.active { background: var(--navy); color: #fff; border-color: var(--navy); font-weight: 600; }
.product-page { padding-top: 18rpx; }
.product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.product-card { overflow: hidden; }
.product-art { height: 188rpx; background: linear-gradient(150deg, #e8efed, #f7f6f0); padding: 20rpx; position: relative; display: flex; align-items: flex-end; }
.product-art::after { content: ""; position: absolute; width: 120rpx; height: 120rpx; border: 18rpx solid rgba(8,127,120,.12); border-radius: 50%; right: 20rpx; top: 22rpx; }
.product-art > text { font-size: 37rpx; font-weight: 800; color: rgba(16,43,67,.78); letter-spacing: 4rpx; position: relative; z-index: 1; }
.stock-tag { position: absolute; top: 16rpx; left: 16rpx; padding: 6rpx 11rpx; border-radius: 20rpx; background: rgba(255,255,255,.75); color: #617079; font-size: 18rpx; }
.product-info { padding: 22rpx 20rpx; }
.product-name { display: block; font-size: 27rpx; font-weight: 700; line-height: 1.45; min-height: 78rpx; }
.product-meta { display: block; color: var(--muted); font-size: 19rpx; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.product-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; }
.product-price { color: var(--teal); font-weight: 800; font-size: 30rpx; }
.unit { font-size: 18rpx; font-weight: 400; }
.add-button { width: 55rpx; height: 55rpx; min-width: 55rpx; border-radius: 16rpx 16rpx 16rpx 4rpx; background: var(--teal); color: #fff; padding: 0; line-height: 55rpx; font-size: 35rpx; }
.package-note { display: block; color: #9aa3a8; font-size: 18rpx; margin-top: 9rpx; }
.cart-fab { position: fixed; right: 28rpx; bottom: 48rpx; z-index: 9; min-width: 140rpx; height: 82rpx; border-radius: 24rpx 24rpx 24rpx 7rpx; background: var(--navy); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 35rpx rgba(16,43,67,.28); font-size: 24rpx; font-weight: 600; }
.cart-count { position: absolute; top: -15rpx; right: -7rpx; background: var(--orange); min-width: 37rpx; height: 37rpx; padding: 0 8rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 19rpx; }
.retry { margin-top: 25rpx; }
