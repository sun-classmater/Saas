<view class="orders-page">
  <view class="orders-head">
    <text class="eyebrow">MY ORDERS</text>
    <text class="head-title">订货与履约</text>
    <text class="head-copy">实时查看确认、付款、发货与签收进度</text>
  </view>
  <scroll-view class="tabs-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tabs-row">
      <view wx:for="{{tabs}}" wx:key="value" class="tab {{activeTab === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectTab">{{item.label}}</view>
    </view>
  </scroll-view>
  <view class="page list-page">
    <view wx:if="{{loading}}" class="loading">正在加载订单…</view>
    <view wx:elif="{{!filtered.length}}" class="empty"><text class="empty-title">暂无相关订单</text>提交订货后可以在手机上全程跟踪</view>
    <view wx:else>
      <view wx:for="{{filtered}}" wx:key="id" class="order-card card" data-id="{{item.id}}" bindtap="openOrder">
        <view class="order-head">
          <view><text class="order-no">{{item.orderNo}}</text><text class="order-date">{{item.dateText}}</text></view>
          <text class="chip {{item.statusClass}}">{{item.statusName}}</text>
        </view>
        <view class="order-main">
          <view class="vehicle-block">{{item.vehicleModel}}</view>
          <view class="order-info">
            <text class="order-type">{{item.typeName}}</text>
            <text class="order-meta">已付 {{item.paidAmount}} · 已发 {{item.shippedAmount}}</text>
          </view>
          <text class="order-total">{{item.totalText}}</text>
        </view>
        <view class="order-foot">
          <text>总单 {{item.groupNo}}</text>
          <text>查看详情 ›</text>
        </view>
      </view>
    </view>
  </view>
</view>
