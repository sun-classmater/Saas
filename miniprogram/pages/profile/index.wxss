.profile-page { min-height: 100vh; }
.profile-hero { padding: 55rpx 34rpx 75rpx; background: radial-gradient(circle at 100% 0, rgba(25,167,157,.28), transparent 36%), linear-gradient(150deg, var(--navy-deep), var(--navy) 80%, #165164); color: #fff; }
.profile-top { display: flex; align-items: center; gap: 20rpx; }
.avatar { width: 94rpx; height: 94rpx; border-radius: 26rpx 26rpx 26rpx 7rpx; background: var(--orange); display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 800; }
.profile-copy { flex: 1; min-width: 0; }
.customer-name { display: block; font-size: 33rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.customer-code { display: block; color: rgba(255,255,255,.55); font-size: 21rpx; margin-top: 7rpx; }
.grade-badge { padding: 9rpx 15rpx; border: 1rpx solid rgba(255,255,255,.2); border-radius: 25rpx; color: #bde9e5; font-size: 20rpx; white-space: nowrap; }
.hero-metrics { display: flex; justify-content: space-around; padding-top: 32rpx; margin-top: 34rpx; border-top: 1rpx solid rgba(255,255,255,.12); }
.hero-metrics view { text-align: center; }
.hero-metrics .metric-strong { display: block; font-size: 29rpx; font-weight: 700; }
.hero-metrics text { display: block; color: rgba(255,255,255,.5); font-size: 18rpx; margin-top: 7rpx; }
.profile-content { margin-top: -38rpx; border-radius: 36rpx 36rpx 0 0; background: var(--cream); position: relative; }
.credit-card, .menu-card, .account-card { padding: 25rpx; margin-bottom: 20rpx; }
.card-head { display: flex; justify-content: space-between; align-items: center; font-weight: 700; }
.card-head .muted { font-size: 20rpx; font-weight: 400; }
.credit-bar { height: 12rpx; border-radius: 8rpx; background: #edf0ee; overflow: hidden; margin: 25rpx 0 14rpx; }
.credit-fill { height: 100%; background: linear-gradient(90deg, var(--teal), var(--orange)); border-radius: 8rpx; }
.credit-row { display: flex; justify-content: space-between; margin-bottom: 13rpx; }
.credit-row text { display: block; color: var(--muted); font-size: 19rpx; }
.credit-row .credit-value { display: block; font-size: 28rpx; font-weight: 700; margin-top: 5rpx; }
.align-right { text-align: right; }
.menu-card { padding: 0 24rpx; }
.menu-row { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.menu-row:last-child { border-bottom: 0; }
.menu-icon { width: 58rpx; height: 58rpx; border-radius: 15rpx; background: var(--teal-light); color: var(--teal); display: flex; align-items: center; justify-content: center; font-size: 27rpx; font-weight: 700; }
.menu-copy { flex: 1; }
.menu-copy text { display: block; font-size: 25rpx; font-weight: 600; }
.menu-copy .menu-small { display: block; color: var(--muted); font-size: 18rpx; margin-top: 5rpx; }
.menu-right { color: #96a0a5; font-size: 20rpx; }
.account-title { display: block; font-size: 26rpx; font-weight: 700; }
.account-address { display: block; color: #5f6f77; font-size: 22rpx; line-height: 1.7; margin-top: 12rpx; }
.logout-button { width: 100%; margin-top: 10rpx; }
.version { display: block; text-align: center; color: #a0a9ad; font-size: 18rpx; margin-top: 35rpx; }
