.detail-page { padding-bottom: 70rpx; }
.status-hero { margin: -28rpx -28rpx 24rpx; padding: 44rpx 34rpx 34rpx; background: linear-gradient(150deg, var(--navy-deep), var(--navy) 78%, #165164); color: #fff; }
.status-top { display: flex; justify-content: space-between; align-items: flex-start; }
.status-hero .eyebrow { color: #77d5ce; }
.status-title { display: block; font-size: 48rpx; font-weight: 700; }
.status-note { display: block; color: rgba(255,255,255,.62); font-size: 23rpx; margin-top: 16rpx; line-height: 1.6; }
.amount-row { display: flex; justify-content: space-between; align-items: flex-end; padding-top: 28rpx; margin-top: 28rpx; border-top: 1rpx solid rgba(255,255,255,.12); }
.amount-label { display: block; color: rgba(255,255,255,.5); font-size: 20rpx; }
.amount-value { display: block; font-size: 44rpx; font-weight: 800; margin-top: 5rpx; }
.amount-side { display: grid; gap: 7rpx; color: rgba(255,255,255,.65); font-size: 20rpx; text-align: right; }
.info-card { padding: 25rpx; margin-bottom: 20rpx; }
.card-title { display: block; font-size: 28rpx; font-weight: 700; margin-bottom: 14rpx; }
.group-head { display: flex; justify-content: space-between; align-items: center; }
.group-total { color: var(--teal); font-size: 28rpx; font-weight: 800; }
.sibling-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.sibling-row:last-child { border-bottom: 0; }
.sibling-no { display: block; color: var(--muted); font-size: 18rpx; margin-top: 4rpx; }
.sibling-right { text-align: right; font-size: 22rpx; font-weight: 700; }
.sibling-status { display: block; color: var(--muted); font-size: 18rpx; font-weight: 400; margin-top: 4rpx; }
.detail-line { display: flex; gap: 16rpx; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.detail-line:last-child { border-bottom: 0; }
.line-art { width: 85rpx; height: 85rpx; border-radius: 14rpx; background: #edf4f1; color: #55746f; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; }
.line-info { flex: 1; }
.line-name { display: block; font-size: 25rpx; font-weight: 600; }
.line-meta { display: block; color: var(--muted); font-size: 19rpx; margin-top: 6rpx; }
.line-ship { display: block; color: var(--teal); font-size: 18rpx; margin-top: 5rpx; }
.line-amount { font-weight: 700; font-size: 24rpx; }
.shipment-block { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.shipment-block:last-child { border-bottom: 0; }
.shipment-head { display: flex; justify-content: space-between; align-items: center; }
.shipment-title { display: block; font-size: 26rpx; font-weight: 700; }
.shipment-date { display: block; color: var(--muted); font-size: 19rpx; margin-top: 5rpx; }
.shipment-summary { display: block; color: #50616b; font-size: 22rpx; margin: 15rpx 0 8rpx; line-height: 1.6; }
.receive-btn { margin-top: 15rpx; width: 100%; }
.payment-line { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.payment-line:last-child { border-bottom: 0; }
.payment-amount { display: block; font-size: 27rpx; font-weight: 700; }
.payment-meta { display: block; color: var(--muted); font-size: 19rpx; margin-top: 5rpx; }
.action-panel { display: flex; gap: 15rpx; padding-top: 14rpx; }
.action-panel .btn { min-height: 82rpx; }
.action-main { flex: 1; }
.action-side { min-width: 210rpx; }
