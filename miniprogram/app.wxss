page {
  --navy: #102b43;
  --navy-deep: #091d2f;
  --teal: #087f78;
  --teal-light: #e9f6f2;
  --orange: #f28b3c;
  --cream: #f4f2eb;
  --paper: #fffdf9;
  --ink: #172733;
  --muted: #718089;
  --line: #e1e6e7;
  --danger: #b64242;
  background: var(--cream);
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, textarea, picker, scroll-view { box-sizing: border-box; }
button { font: inherit; }
.page { min-height: 100vh; padding: 28rpx 28rpx 140rpx; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.card { background: var(--paper); border-radius: 24rpx; box-shadow: 0 8rpx 30rpx rgba(16,43,67,.055); border: 1rpx solid rgba(16,43,67,.06); }
.eyebrow { display: block; font-size: 20rpx; color: var(--teal); letter-spacing: 3rpx; font-weight: 700; margin-bottom: 8rpx; }
.section-title { display: flex; align-items: center; justify-content: space-between; margin: 30rpx 0 18rpx; }
.section-title text:first-child { font-size: 32rpx; font-weight: 700; }
.section-title text:last-child { color: var(--muted); font-size: 23rpx; }
.muted { color: var(--muted); }
.money { font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
.price { color: var(--teal); font-weight: 800; }
.btn { min-height: 80rpx; padding: 0 28rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; border: 0; line-height: 1; font-size: 27rpx; font-weight: 600; }
.btn::after { border: 0; }
.btn-primary { background: var(--teal); color: #fff; }
.btn-orange { background: var(--orange); color: #fff; }
.btn-ghost { background: var(--paper); color: var(--ink); border: 1rpx solid var(--line); }
.btn-danger { background: #fff4f2; color: var(--danger); border: 1rpx solid #f1d1cc; }
.btn-small { min-height: 58rpx; padding: 0 20rpx; font-size: 23rpx; border-radius: 12rpx; }
.chip { display: inline-flex; align-items: center; gap: 8rpx; padding: 8rpx 15rpx; border-radius: 30rpx; background: #eff2f2; color: #617079; font-size: 21rpx; }
.chip-success { background: #e9f6ef; color: #19704f; }
.chip-warning { background: #fff3e4; color: #a96810; }
.chip-danger { background: #fff0ee; color: var(--danger); }
.chip-info { background: #eaf2f8; color: #356b91; }
.empty { padding: 100rpx 30rpx; text-align: center; color: var(--muted); line-height: 1.8; }
.empty-title { display: block; color: var(--ink); font-size: 31rpx; font-weight: 700; margin-bottom: 10rpx; }
.field { display: block; margin-bottom: 24rpx; }
.field-label { display: block; color: #45545d; font-size: 23rpx; font-weight: 600; margin-bottom: 11rpx; }
.field-input { width: 100%; min-height: 80rpx; padding: 0 22rpx; background: #fff; border: 1rpx solid var(--line); border-radius: 14rpx; font-size: 27rpx; }
.field-textarea { width: 100%; height: 160rpx; padding: 20rpx 22rpx; background: #fff; border: 1rpx solid var(--line); border-radius: 14rpx; font-size: 27rpx; }
.field-hint { color: var(--muted); font-size: 21rpx; line-height: 1.6; margin-top: 8rpx; display: block; }
.summary-row { display: flex; justify-content: space-between; align-items: center; padding: 15rpx 0; color: #5f6e76; }
.summary-row:last-child { border-bottom: 0; }
.summary-row .value { color: var(--ink); font-weight: 600; }
.fab { position: fixed; right: 28rpx; bottom: 130rpx; z-index: 8; width: 98rpx; height: 98rpx; border-radius: 28rpx 28rpx 28rpx 8rpx; background: var(--navy); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 14rpx 34rpx rgba(16,43,67,.25); font-size: 40rpx; }
.badge { position: absolute; top: -11rpx; right: -12rpx; min-width: 34rpx; height: 34rpx; padding: 0 8rpx; border-radius: 18rpx; background: var(--orange); color: #fff; font-size: 19rpx; display: flex; align-items: center; justify-content: center; }
.loading { padding: 100rpx 0; text-align: center; color: var(--muted); }
.divider { height: 1rpx; background: var(--line); margin: 22rpx 0; }
.callout { padding: 20rpx; border-radius: 16rpx; background: #f0f8f6; border: 1rpx solid #d4e9e5; color: #426c67; font-size: 22rpx; line-height: 1.65; }
.form-error { color: var(--danger); background: #fff3f1; border-radius: 12rpx; padding: 15rpx; margin: 20rpx 0; font-size: 23rpx; }
.route-line { height: 3rpx; background: linear-gradient(90deg, var(--teal), var(--orange), transparent); border-radius: 2rpx; margin: 18rpx 0; }
