{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "后端 API (apps/backend)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/backend/src/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "env": { "NODE_ENV": "development" }
    },
    {
      "name": "前端 Vite (apps/frontend)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "cwd": "${workspaceFolder}/apps/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "前端 Vite (兼容模式，esbuild 被拦截时用)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": ["--configLoader", "native"],
      "cwd": "${workspaceFolder}/apps/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "全栈：后端 + 前端",
      "configurations": ["后端 API (apps/backend)", "前端 Vite (apps/frontend)"]
    }
  ]
}
